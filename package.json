{
  "name": "cachenuke",
  "version": "1.0.1",
  "description": "🧹 Universal development cache cleaner with beautiful interactive UI. Clean npm, pnpm, yarn, workspace builds, and 20+ other caches with one command.",
  "main": "dist/core.js",
  "types": "dist/core.d.ts",
  "bin": {
    "cachenuke": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node ./dist/cli.js scan --all",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test dist/**/*.test.js && node ./dist/cli.js targets",
    "demo": "node ./dist/cli.js --help"
  },
  "keywords": [
    "cache",
    "cli",
    "cleanup",
    "development",
    "typescript",
    "interactive",
    "terminal",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "workspace",
    "devtools",
    "cross-platform"
  ],
  "author": "Pinku kumar <kumarpinku494@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/kumar-pinku/cachenuke-cli.git"
  },
  "bugs": {
    "url": "https://github.com/kumar-pinku/cachenuke-cli/issues"
  },
  "homepage": "https://github.com/kumar-pinku/cachenuke-cli#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "log-symbols": "^7.0.1",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  }
}
